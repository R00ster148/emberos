#!/bin/bash
# Runs at each login; does the one-time setup the first time.
flag="$HOME/.config/emberos/firstrun-done"
[ -e "$flag" ] && exit 0
mkdir -p "$(dirname "$flag")"
xdg-user-dirs-update 2>/dev/null
# Desktop launchers: mark executable and trusted so xfdesktop runs them without a warning.
for f in "$HOME"/Desktop/*.desktop; do
  [ -e "$f" ] || continue
  chmod +x "$f"
  gio set -t string "$f" metadata::xfce-exe-checksum "$(sha256sum "$f" | cut -d' ' -f1)" 2>/dev/null
done
# Wallpaper: xfdesktop keys it by output name (VirtualBox: Virtual-1, QEMU: default), so set every output.
sleep 3
W=/usr/share/backgrounds/emberos-default.jpg
for mon in $(xrandr --query 2>/dev/null | awk '/ connected/{print $1}') default 0; do
  b=/backdrop/screen0/monitor$mon/workspace0
  xfconf-query -c xfce4-desktop -p $b/last-image -s "$W" 2>/dev/null || xfconf-query -c xfce4-desktop -p $b/last-image -n -t string -s "$W"
  xfconf-query -c xfce4-desktop -p $b/image-style -s 5 2>/dev/null || xfconf-query -c xfce4-desktop -p $b/image-style -n -t int -s 5
done
xfdesktop --reload >/dev/null 2>&1 &
touch "$flag"
ember-welcome &
